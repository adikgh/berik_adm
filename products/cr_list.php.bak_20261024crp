	<script>
		(function () {
			var pop = document.querySelector('.cr_add_block'), busy = false;
			var msg = function (t) { if (window.mess) mess(t); else alert(t); };
			document.querySelectorAll('.cr_add_pop').forEach(function (b) {
				b.addEventListener('click', function () { pop.classList.add('pop_bl_act'); pop.querySelector('.cr_name').focus(); });
			});
			pop.querySelectorAll('.cr_add_back').forEach(function (b) {
				b.addEventListener('click', function () { pop.classList.remove('pop_bl_act'); });
			});
			pop.querySelector('.cr_add_btn').addEventListener('click', function () {
				if (busy) return;
				var name = pop.querySelector('.cr_name').value.trim(), unit = pop.querySelector('.cr_unit');
				if (!name) { msg(<?=json_encode(t::w('Enter name', 'Атауын жазыңыз'), JSON_UNESCAPED_UNICODE)?>); return; }
				var fd = new FormData();
				fd.append('name', name);
				fd.append('price', pop.querySelector('.cr_price').value);
				if (unit) fd.append('unit', unit.value);
				busy = true;
				fetch('/products/get.php?<?=$cr['kind']?>_add', { method: 'POST', body: fd, credentials: 'same-origin' })
					.then(function (r) { return r.text(); })
					.then(function (t) {
						busy = false;
						t = t.trim();
						if (t == 'yes') { msg(<?=json_encode(t::w('Added', 'Қосылды'), JSON_UNESCAPED_UNICODE)?>); setTimeout(function () { location.reload(); }, 400); }
						else if (t == 'exists') msg(<?=json_encode(t::w('Already exists', 'Мұндай атау бар'), JSON_UNESCAPED_UNICODE)?>);
						else msg(<?=json_encode(t::w('Error, try again', 'Қате, қайта көріңіз'), JSON_UNESCAPED_UNICODE)?>);
					})
					.catch(function () { busy = false; msg(<?=json_encode(t::w('Error, try again', 'Қате, қайта көріңіз'), JSON_UNESCAPED_UNICODE)?>); });
			});
			var s = document.querySelector('.cr_search');
			if (s) s.addEventListener('input', function () {
				var q = s.value.trim().toLowerCase();
				document.querySelectorAll('.cr_row').forEach(function (r) { r.style.display = !q || r.dataset.name.indexOf(q) > -1 ? '' : 'none'; });
			});
		})();
	</script>
