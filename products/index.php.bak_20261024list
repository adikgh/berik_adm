	<script>
		// каталог чиптері + іздеу (бетте, қайта жүктемей)
		(function () {
			var chips = document.querySelectorAll('.pr_cat_chips .k_br_i'), inp = document.querySelector('.product_search');
			if (!chips.length) return;
			var cur = (location.hash.match(/cat=(\d+)/) || [])[1] || '';
			if (window.jQuery && inp) jQuery(inp).off('input'); // ескі ajax іздеудің орнына
			function apply() {
				var q = inp ? inp.value.trim().toLowerCase() : '';
				chips.forEach(function (c) { c.classList.toggle('k_br_act', c.dataset.cat === cur); });
				var shown = {};
				document.querySelectorAll('.uc_u2q .uc_ui2[data-cat]').forEach(function (r) {
					var ok = (!cur || r.dataset.cat === cur) && (!q || r.dataset.name.indexOf(q) > -1);
					r.style.display = ok ? '' : 'none';
					if (ok) shown[r.dataset.cat] = 1;
				});
				document.querySelectorAll('.uc_u2q .pr_grp[data-cat]').forEach(function (g) { g.style.display = shown[g.dataset.cat] ? '' : 'none'; });
			}
			chips.forEach(function (c) {
				c.addEventListener('click', function (e) {
					e.preventDefault();
					cur = c.dataset.cat;
					history.replaceState(null, '', cur ? '#cat=' + cur : location.pathname + location.search);
					apply();
				});
			});
			if (inp) inp.addEventListener('input', apply);
			if (cur && !document.querySelector('.pr_cat_chips [data-cat="' + cur + '"]')) cur = '';
			apply();
		})();
	</script>
