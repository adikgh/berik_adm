AddDefaultCharset utf-8
ErrorDocument 404 /

<FilesMatch "\.(sql|bak|example)$">
	Require all denied
</FilesMatch>

# Әзірлеуші панелі - осы сайттың алиасы (dist → dlv сияқты): хост dev.* не devb.* болса (dev.berik.c, devb.gprog.kz),
# /assets/ мен /dev/-дан басқа сұраудың бәрі dev/ папкасына барады, сілтемелер сол күйі қалады (/companies/ т.б.).
# Басқа хосттан (админнен) /dev/ ашылмайды.
RewriteEngine On
RewriteCond %{HTTP_HOST} ^devb?\. [NC]
RewriteRule ^(?!(?:dev|assets)/)(.*)$ dev/$1 [L]
RewriteCond %{HTTP_HOST} !^devb?\. [NC]
RewriteRule ^dev(/|$) - [R=404,L]

# Ескі (шаблоннан қалған) беттер: мәзірде жоқ, компания сүзгісі мен кіру тексерісі жоқ, кейбірі базаны өзгертеді
# (md5.php, products/upd-arh.php). Файлдар орнында, бірақ ашылмайды (2026-11-21 аудит).
# Архив енді /products/ ішінде (#cat=arh).
RewriteRule ^products/archive(/|$) /products/#cat=arh [R=302,NE,L]
RewriteRule ^(all|products/(all|add|warehouses|displacement|remains|rent|setting))(/|$) - [R=404,L]
RewriteRule ^(md5|dev)\.php$ - [R=404,L]
RewriteRule ^products/(upd-arh|get_arh|warehouses2?|ss|sort-filter)\.php$ - [R=404,L]
